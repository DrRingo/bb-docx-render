{:paths ["."]

 ;; Cấu hình để bbin tạo "binary" bb-docx-render.
 ;; bbin clone toàn bộ repo → fill_docx.bb và render.py nằm cùng thư mục.
 ;; fill_docx.bb dùng --project script-dir nên uv tìm đúng pyproject.toml.
 :bbin/bin
 {bb-docx-render {:main-opts ["fill_docx.bb"]}}

 :tasks
 {docx:fill
  {:doc "Dien JSON/YAML/TOML vao template DOCX. Usage: bb docx:fill <template.docx> <data.json|yaml|toml> [-o output.docx|output-template]"
   :requires ([babashka.process :refer [shell]])
   :task (let [args *command-line-args*]
           ;; Goi bb fill_docx.bb truc tiep (khong qua uv run bb)
           (apply shell (concat ["bb" "fill_docx.bb"] args)))}

  docx:install
  {:doc "Cài các dependency Python vào uv env"
   :task ((requiring-resolve 'babashka.process/shell)
          "uv" "add" "docxtpl" "jinja2" "python-docx" "pyyaml" "tomli")}}}
