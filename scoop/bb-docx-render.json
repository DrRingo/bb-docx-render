{
  "version": "0.1.4",
  "description": "Render DOCX templates using Babashka and Python",
  "homepage": "https://github.com/DrRingo/bb-docx-render",
  "license": "Apache-2.0",
  "depends": [
    "babashka",
    "uv"
  ],
  "url": "https://github.com/DrRingo/bb-docx-render/archive/refs/tags/0.1.4.tar.gz",
  "hash": "fadc6b4ee87701c353b5cda4d42af4509efbb0219b2623e535c92d287245f316",
  "extract_dir": "bb-docx-render-0.1.4",
  "installer": {
    "script": [
      "New-Item -ItemType Directory \"$dir\\libexec\" | Out-Null",
      "Move-Item \"$dir\\fill_docx.bb\"              \"$dir\\libexec\\fill_docx.bb\"",
      "Move-Item \"$dir\\render.py\"                 \"$dir\\libexec\\render.py\"",
      "Move-Item \"$dir\\pyproject.toml\"            \"$dir\\libexec\\pyproject.toml\"",
      "Move-Item \"$dir\\uv.lock\"                   \"$dir\\libexec\\uv.lock\"",
      "Move-Item \"$dir\\scoop\\fill-docx-impl.ps1\" \"$dir\\libexec\\fill-docx-impl.ps1\"",
      "Set-Content \"$dir\\fill-docx.bat\" '@powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%~dp0libexec\\fill-docx-impl.ps1\" %*' -Encoding ASCII"
    ]
  },
  "bin": "fill-docx.bat"
}